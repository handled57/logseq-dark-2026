{
  "name": "logseq-claudseq",
  "version": "0.1.0",
  "description": "A Claude Code pane in Logseq's left sidebar: chat with your local claude CLI, approve what it does, and reopen past sessions, through a small loopback bridge that writes nothing to your graph.",
  "author": "Peter Cole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handled57/logseq-dark-2026.git"
  },
  "homepage": "https://github.com/handled57/logseq-dark-2026#readme",
  "bugs": "https://github.com/handled57/logseq-dark-2026/issues",
  "keywords": [
    "logseq",
    "plugin",
    "claude",
    "claude-code",
    "sidebar",
    "assistant"
  ],
  "scripts": {
    "test": "node --test test/package.test.mjs test/bridge.test.mjs test/pane.test.mjs",
    "build": "node ../../scripts/build-release.mjs",
    "verify:release": "node ../../scripts/verify-release.mjs",
    "check": "npm test && npm run build && npm run verify:release"
  },
  "files": [
    "index.html",
    "index.js",
    "markdown.js",
    "timeline.js",
    "bridge",
    "lib",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "manifest.json"
  ],
  "release": {
    "files": [
      "package.json",
      "manifest.json",
      "index.html",
      "index.js",
      "markdown.js",
      "timeline.js",
      "bridge/claudseq-bridge.mjs",
      "icon.svg",
      "README.md",
      "CHANGELOG.md",
      "THIRD_PARTY_NOTICES.md"
    ]
  },
  "repo": "handled57/logseq-dark-2026",
  "title": "Claudseq",
  "main": "index.html",
  "effect": true,
  "logseq": {
    "id": "logseq-claudseq",
    "title": "Claudseq",
    "icon": "./icon.svg",
    "main": "index.html"
  }
}
