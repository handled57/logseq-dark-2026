{
  "name": "logseq-able-table",
  "version": "0.2.0",
  "description": "Search and filter a rendered Markdown table in place, without editing the block, restructuring the Markdown, or writing anything to the graph.",
  "author": "Peter Cole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handled57/logseq-dark-2026.git"
  },
  "homepage": "https://github.com/handled57/logseq-dark-2026#readme",
  "bugs": "https://github.com/handled57/logseq-dark-2026/issues",
  "keywords": [
    "logseq",
    "plugin",
    "table",
    "search",
    "filter"
  ],
  "scripts": {
    "test": "node --test test/package.test.mjs test/able-table.test.mjs",
    "build": "node ../../scripts/build-release.mjs",
    "verify:release": "node ../../scripts/verify-release.mjs",
    "check": "npm test && npm run build && npm run verify:release"
  },
  "files": [
    "index.html",
    "index.js",
    "lib",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "manifest.json"
  ],
  "release": {
    "files": [
      "package.json",
      "manifest.json",
      "index.html",
      "index.js",
      "icon.svg",
      "README.md",
      "CHANGELOG.md",
      "THIRD_PARTY_NOTICES.md"
    ]
  },
  "repo": "handled57/logseq-dark-2026",
  "title": "Able Table",
  "main": "index.html",
  "effect": true,
  "logseq": {
    "id": "logseq-able-table",
    "title": "Able Table",
    "icon": "./icon.svg",
    "main": "index.html"
  }
}
