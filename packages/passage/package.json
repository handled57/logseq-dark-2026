{
  "name": "logseq-passage",
  "version": "0.1.0",
  "description": "Insert a Bible passage into a Logseq block, with a canonical reference, per-chapter tags and text from a local index.",
  "author": "Peter Cole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handled57/logseq-dark-2026.git"
  },
  "homepage": "https://github.com/handled57/logseq-dark-2026#readme",
  "bugs": "https://github.com/handled57/logseq-dark-2026/issues",
  "keywords": [
    "logseq",
    "plugin",
    "bible",
    "passage",
    "reference"
  ],
  "scripts": {
    "test": "node --test test/package.test.mjs test/bible.test.mjs test/passage.test.mjs test/contract.test.mjs",
    "build": "node ../../scripts/build-release.mjs",
    "verify:release": "node ../../scripts/verify-release.mjs",
    "check": "npm test && npm run build && npm run verify:release"
  },
  "files": [
    "index.html",
    "index.js",
    "bible.js",
    "resources/bible.books.json",
    "lib",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "manifest.json"
  ],
  "release": {
    "files": [
      "package.json",
      "manifest.json",
      "index.html",
      "index.js",
      "bible.js",
      "resources/bible.books.json",
      "icon.svg",
      "README.md",
      "CHANGELOG.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "unpackedLocalFiles": [
      "resources/bible.text.json"
    ]
  },
  "repo": "handled57/logseq-dark-2026",
  "title": "Passage",
  "main": "index.html",
  "effect": true,
  "logseq": {
    "id": "logseq-passage",
    "title": "Passage",
    "icon": "./icon.svg",
    "main": "index.html"
  }
}
